<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^nutriendohabitos\.es$ [NC]
  RewriteRule ^ https://www.nutriendohabitos.es%{REQUEST_URI} [L,R=301]
</IfModule>

# Nutriendo Hábitos
ErrorDocument 404 /404.html

# Las reservas online ya no son públicas: la antigua página de reservas lleva al formulario de contacto
RedirectMatch 301 ^/reservar\.html$ /contacto.html
RedirectMatch 302 ^/alimentacion-cancer-quimioterapia\.html$ /nutricion-oncologica-valladolid.html
# Página privada de citas de seguimiento: fuera de Google y sin pasar el enlace a otras webs
<Files "reserva-seguimiento.html">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow"
    Header set Referrer-Policy "no-referrer"
  </IfModule>
</Files>

# Comprimir texto (páginas más rápidas)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# Guardar en caché imágenes y archivos que no cambian
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/wasm "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
